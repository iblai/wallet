# ibl.ai platform configuration (read by the `iblai` CLI).
# Matches the rest of the ibl.ai workspace: production iblai.app, default
# `main` tenant. If credentialsai has its own dedicated platform/tenant,
# change PLATFORM (and re-run `iblai add auth`) — it sets
# NEXT_PUBLIC_MAIN_TENANT_KEY in .env.local.
DOMAIN=iblai.app
PLATFORM=main
# TOKEN=  # only needed to customize the hosted login page (Step 2); optional

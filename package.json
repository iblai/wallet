{
  "name": "wallet",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "predev": "next telemetry disable",
    "prebuild": "next telemetry disable",
    "prestart": "next telemetry disable",
    "dev": "NODE_OPTIONS=\"--no-experimental-webstorage\" next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "oxlint --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts --project=chromium --project=mobile --project=demo",
    "test:e2e:demo": "playwright test --config e2e/playwright.config.ts --project=demo",
    "test:e2e:all": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:accounts": "node e2e/create-accounts.mjs",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed --project=chromium",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "release": "release-it"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@iblai/agent-ai": "^2.10.0",
    "@iblai/iblai-js": "2.50.0",
    "@iblai/iblai-web-mentor": "^2.0.1",
    "@livekit/components-react": "^2.9.23",
    "@livekit/components-styles": "^1.2.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@stripe/stripe-js": "^9.15.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "livekit-client": "^2.20.1",
    "lucide-react": "^1.14.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-paginate": "^8.3.0",
    "react-redux": "^9.2.0",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^17.4.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "release-it": "^21.1.1",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
